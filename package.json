{
  "name": "@verdeect/kit",
  "version": "1.0.0-rc.6",
  "description": "Общий инфраструктурный пакет сервисов Вердикта 2.0: конфигурация, наблюдаемость, HTTP, БД с RLS, идемпотентность, сообщения, шифр, Redis, тестовый контур",
  "keywords": [
    "verdeect",
    "nestjs",
    "infrastructure"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smskin/verdeect-kit.git"
  },
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "alerts",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto/index.d.ts",
      "default": "./dist/crypto/index.js"
    },
    "./database": {
      "types": "./dist/database/index.d.ts",
      "default": "./dist/database/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./idempotency": {
      "types": "./dist/idempotency/index.d.ts",
      "default": "./dist/idempotency/index.js"
    },
    "./messaging": {
      "types": "./dist/messaging/index.d.ts",
      "default": "./dist/messaging/index.js"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "default": "./dist/observability/index.js"
    },
    "./redis": {
      "types": "./dist/redis/index.d.ts",
      "default": "./dist/redis/index.js"
    },
    "./testing/timeout-scale": {
      "types": "./dist/testing/timeout-scale.d.ts",
      "default": "./dist/testing/timeout-scale.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "development": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "verdeect-kit": "dist/cli/main.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:timing": "vitest run -c vitest.timing.config.ts",
    "test:package": "vitest run -c vitest.package.config.ts",
    "pack:check": "pnpm build && pnpm test:package",
    "db:fixtures": "drizzle-kit generate --config test/fixtures/database/drizzle.config.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "semver": "7.8.6",
    "shell-quote": "1.12.0",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-fastify": "^12.1.0",
    "@nestjs/testing": "^12.1.0",
    "@prometheus-io/client": "^0.16.1",
    "@sentry/nestjs": "^11.7.0",
    "@verdeect/auth": "^1.0.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.2.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.0",
    "pg": "^8.23.0",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "testcontainers": "^12.2.0",
    "vitest": "^5.0.0",
    "zod": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/testing": {
      "optional": true
    },
    "amqp-connection-manager": {
      "optional": true
    },
    "amqplib": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "testcontainers": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@nestjs/testing": "12.1.3",
    "@prometheus-io/client": "0.16.1",
    "@sentry/nestjs": "11.7.0",
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@swc/core": "1.16.18",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/semver": "7.8.0",
    "@types/shell-quote": "1.7.5",
    "@verdeect/auth": "1.0.1",
    "amqp-connection-manager": "5.0.1",
    "amqplib": "2.2.0",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "65.4.0",
    "fastify": "5.12.5",
    "globals": "17.13.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "testcontainers": "12.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.4",
    "zod": "4.6.7"
  }
}
