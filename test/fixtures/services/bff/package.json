{
  "name": "verdeect-bff",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tests/Browser/tsconfig.json && tsc -p tests/Browser/test-spa/tsconfig.json && tsc -p scripts/tsconfig.json",
    "check:undici": "node scripts/check-runtime-undici.ts",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm -r --workspace-concurrency=1 --if-present test:integration",
    "test:timing": "pnpm -r --workspace-concurrency=1 --if-present test:timing",
    "build": "pnpm -r --if-present build",
    "test:protocol": "pnpm --filter bff test:protocol",
    "test:browser": "playwright test",
    "build:test-spa": "vite build --config tests/Browser/test-spa/vite.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "ioredis": "6.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.5"
  }
}
