{
  "name": "verdeect-identity",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tests/Browser/tsconfig.json --noEmit && tsc -p tests/Visual/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json",
    "check:undici": "node --experimental-strip-types scripts/check-runtime-undici.ts",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm -r --if-present test:integration",
    "build": "pnpm --filter identity-pages build && pnpm --filter identity build",
    "test:browser": "playwright test",
    "test:visual": "playwright test -c playwright.visual.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
