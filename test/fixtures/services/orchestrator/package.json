{
    "name": "verdeect-orchestrator",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.11.2",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "lint": "pnpm run lint:eslint",
        "check:deps": "node scripts/check-no-dsh-packages.mjs",
        "check:migrations": "node --test scripts/check-migrations.test.mjs && node scripts/check-migrations.mjs",
        "lint:eslint": "eslint apps packages scripts runtime/patches runtime/scripts runtime/entrypoint.spec.ts eslint.config.js",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "pnpm -r --if-present typecheck",
        "build": "pnpm -r --if-present build",
        "test": "pnpm -r --if-present test",
        "test:integration": "pnpm -r --if-present test:integration"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "24.19.2",
        "eslint": "10.12.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.13.0",
        "prettier": "3.9.10",
        "typescript": "5.9.3",
        "typescript-eslint": "8.71.2"
    }
}
