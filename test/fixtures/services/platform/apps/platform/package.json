{
  "name": "platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --enable-source-maps dist/main.js",
    "cli": "node --enable-source-maps dist/cli.js",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:timing": "vitest run -c vitest.timing.config.ts",
    "test:protocol": "vitest run -c vitest.protocol.config.ts",
    "test:load": "vitest run -c vitest.load.config.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@nestjs/schedule": "12.0.2",
    "@prometheus-io/client": "0.16.1",
    "@sentry/nestjs": "11.7.0",
    "@verdeect/auth": "1.0.1",
    "amqp-connection-manager": "5.0.1",
    "amqplib": "2.2.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@swc/core": "1.16.18",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "drizzle-kit": "0.31.11",
    "testcontainers": "12.2.1",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.4"
  }
}
